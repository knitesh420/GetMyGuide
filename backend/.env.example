# ===== Core =====
# Node environment: development | production
NODE_ENV=development
# Port the API listens on
PORT=8000
# Set to WINDOWS only when running on Windows (affects path handling)
# OS=WINDOWS

# MongoDB connection string.
# WARNING: never point a local/dev environment at the production database.
DATABASE_URL=mongodb://localhost:27017/getmyguide

# ===== Auth / JWT =====
# Use long, random, unique values in production. The app refuses to boot in
# production if these are missing or left at their insecure defaults.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRE=1d
JWT_REFRESH_EXPIRE=3d
# Legacy alias (optional; falls back to JWT_ACCESS_SECRET)
# JWT_SECRET=

# ===== Email (Resend) =====
RESEND_API_KEY=your_resend_api_key

# ===== Payments (Razorpay) =====
RAZORPAY_API_KEY=your_razorpay_key_id
RAZORPAY_API_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Base URL used in guide verification payment links
GUIDE_PAYMENT_LINK_BASE_URL=https://getmyguide.in/system/guide-verification-payment

# ===== Media (Cloudinary) =====
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ===== Company details (used in emails / invoices) =====
COMPANY_NAME=GetMyGuide
COMPANY_ADDRESS=
COMPANY_LOGO_URL=
COMPANY_SUPPORT_EMAIL=support@getmyguide.in
COMPANY_SUPPORT_PHONE=
COMPANY_WEBSITE=https://getmyguide.in

# ===== Admin seed (used only by scripts/seedAdmin.ts) =====
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
# Must be at least 12 characters
ADMIN_PASSWORD=

# ===== Background jobs =====
# Notification watcher poll interval in ms (default 300000 = 5 minutes)
# NOTIFICATION_WATCHER_INTERVAL_MS=300000
