# ===== Core =====
# Node environment: development | production
NODE_ENV=development
# Port the API listens on
PORT=8000
# NOTE: the platform is now detected via process.platform. The old OS=WINDOWS
# variable is no longer read and can be deleted from existing .env files.

# MongoDB connection string.
# WARNING: never point a local/dev environment at the production database.
# The server prints the target database on boot and warns loudly if a
# non-production process is connected to a remote cluster.
DATABASE_URL=mongodb://localhost:27017/getmyguide

# ===== CORS =====
# Comma-separated origins allowed to send credentialed requests.
# Defaults to localhost:3000, localhost:5173, getmyguide.in and www.getmyguide.in.
# CORS_ORIGINS=https://getmyguide.in,https://www.getmyguide.in

# ===== Cookies =====
# SameSite policy for the auth cookies: lax | strict | none.
# 'lax' (the default) is correct when the frontend and API share a registrable
# domain, e.g. getmyguide.in and api.getmyguide.in. Only set 'none' if the
# frontend moves to an unrelated domain — it re-opens the CSRF surface that
# dropping the urlencoded body parser and using 'lax' together close.
# COOKIE_SAMESITE=lax
# Set to share one cookie across subdomains, e.g. .getmyguide.in. Unset in dev.
# COOKIE_DOMAIN=.getmyguide.in

# ===== Auth / JWT =====
# Use long, random, unique values in production. The app refuses to boot in
# production if these are missing or left at their insecure defaults.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRE=1d
JWT_REFRESH_EXPIRE=3d
# Legacy alias (optional; falls back to JWT_ACCESS_SECRET)
# JWT_SECRET=

# ===== Email (Resend) =====
RESEND_API_KEY=your_resend_api_key

# ===== Payments (Razorpay) =====
RAZORPAY_API_KEY=your_razorpay_key_id
RAZORPAY_API_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Base URL used in guide verification payment links
GUIDE_PAYMENT_LINK_BASE_URL=https://getmyguide.in/system/guide-verification-payment

# ===== Media (Cloudinary) =====
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ===== Company details (used in emails / invoices) =====
COMPANY_NAME=GetMyGuide
COMPANY_ADDRESS=
COMPANY_LOGO_URL=
COMPANY_SUPPORT_EMAIL=support@getmyguide.in
COMPANY_SUPPORT_PHONE=
COMPANY_WEBSITE=https://getmyguide.in

# ===== Admin seed (used only by scripts/seedAdmin.ts) =====
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
# Must be at least 12 characters
ADMIN_PASSWORD=

# ===== Background jobs =====
# Notification watcher poll interval in ms (default 300000 = 5 minutes)
# NOTIFICATION_WATCHER_INTERVAL_MS=300000
