{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES2020",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "typeRoots": ["./node_modules/@types", "./server/types", "./server/mongo/types"],
    "paths": {
      "@/*": ["./*"],
      "@services/*": ["./server/services/*"],
      "@config/*": ["./server/config/*"],
      "@middleware/*": ["./server/middleware/*"],
      "@modules/*": ["./server/modules/*"],
      "@provider/*": ["./server/provider/*"],
      "@utils/*": ["./server/utils/*"],
      "@mongo": ["./server/mongo/index"],
      "@mongo/*": ["./server/mongo/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // tests/ is compiled by tsconfig.server.json (Node/CommonJS), not by Next.
  "exclude": ["node_modules", "backend", "frontend", "tests", "server/scripts", ".next", "build"]
}
