# API Base URL - used for all backend API calls
NEXT_PUBLIC_API_URL=http://localhost:8000

# Razorpay Payment Gateway Key (public key only - never expose secret key)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# Canonical production site URL - used for metadataBase, canonical URLs, sitemap.xml, and OG tags
NEXT_PUBLIC_SITE_URL=https://getmyguide.in
