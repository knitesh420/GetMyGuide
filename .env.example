# =============================================================================
# GetMyGuide — unified Next.js app (frontend + API in one process)
# =============================================================================
# After the migration the browser and the API share one origin, so
# NEXT_PUBLIC_API_URL becomes the relative prefix "/api": every client call is a
# same-origin request served by this same deployment. Only set an absolute URL
# if you are deliberately pointing this build at a different API host (e.g. the
# legacy Hostinger backend during cutover).
# =============================================================================

# ===== Public (baked into the client bundle at build time) =====
# "/api" = same-origin, served by app/api/. Do NOT set this to the Vercel URL.
# It must NOT be empty: the Express routes are mounted under /api so they do not
# collide with the Next.js page routes (/dashboard, /blogs, ...).
NEXT_PUBLIC_API_URL=/api

# Origin serving legacy disk-backed media (/media/*). Until the one remaining
# advertisement video is moved to Cloudinary, this stays pointed at the old
# backend. Unset it once that row is migrated.
NEXT_PUBLIC_MEDIA_FALLBACK_URL=https://api.getmyguide.in
# Razorpay public key only — never the secret.
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here
# Canonical site URL — metadataBase, canonical tags, sitemap.xml, OG tags.
NEXT_PUBLIC_SITE_URL=https://getmyguide.in

# ===== Core =====
NODE_ENV=development

# MongoDB connection string.
# WARNING: never point a local/dev environment at the production database.
DATABASE_URL=mongodb://localhost:27017/getmyguide

# ===== Cookies =====
# lax | strict | none. 'lax' is correct now that the frontend and API share an
# origin — strictly safer than the previous cross-subdomain setup.
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.getmyguide.in

# ===== Auth / JWT =====
# Long, random, unique values in production. The app refuses to boot in
# production if these are missing or left at their insecure defaults.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRE=1d
JWT_REFRESH_EXPIRE=3d

# ===== Email (Resend) =====
RESEND_API_KEY=your_resend_api_key

# ===== Payments (Razorpay) =====
RAZORPAY_API_KEY=your_razorpay_key_id
RAZORPAY_API_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
GUIDE_PAYMENT_LINK_BASE_URL=https://getmyguide.in/system/guide-verification-payment

# ===== Media (Cloudinary) =====
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ===== Company details (used in emails / invoices) =====
COMPANY_NAME=GetMyGuide
COMPANY_ADDRESS=
COMPANY_LOGO_URL=
COMPANY_SUPPORT_EMAIL=support@getmyguide.in
COMPANY_SUPPORT_PHONE=
COMPANY_WEBSITE=https://getmyguide.in

# ===== Admin seed (scripts only) =====
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
# Must be at least 12 characters
ADMIN_PASSWORD=

# ===== Background jobs =====
# The setInterval notification watcher cannot run on serverless. It is replaced
# by POST /api/cron/tick, driven by an external scheduler. This shared secret
# authenticates that caller — generate a long random value.
CRON_SECRET=change-me-to-a-long-random-string
# NOTIFICATION_WATCHER_INTERVAL_MS=300000

# ===== Legacy (no longer read) =====
# PORT          — Next owns the port; use `next dev -p` instead.
# CORS_ORIGINS  — same-origin now, no cross-origin allowlist needed.
